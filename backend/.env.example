# ──────────────────────────────────────────────
# SMCPP Backend — Variables de entorno
# Copia este archivo a .env y rellena los valores
# ──────────────────────────────────────────────

# Servidor
NODE_ENV=development
PORT=3001

# Base de datos PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smcpp?schema=public"

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_en_produccion
JWT_EXPIRES_IN=8h

# Bcrypt
BCRYPT_ROUNDS=12

# CORS (orígenes permitidos, separados por comas)
CORS_ORIGINS=http://localhost:8443,http://localhost:5173,http://localhost:3000

# Archivos
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
